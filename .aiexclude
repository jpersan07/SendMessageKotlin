# Ficheros que los asistentes de IA no deben leer (misma sintaxis que .gitignore)

# Compilación y cachés de Gradle/Kotlin: se regeneran y ocupan más de 100 MB
build/
.gradle/
.kotlin/
.cxx/
.externalNativeBuild/
captures/

# Configuración local del IDE y de la máquina (incluye la ruta del SDK)
.idea/
*.iml
local.properties

# Documentación generada por Dokka: se lee mejor el KDoc del código fuente
documentation/html/
documentation/javadoc/

# APK generados y sus metadatos
*.apk
*.aab
app/release/

# Claves de firma del APK: nunca deben salir de la máquina
*.jks
*.keystore

# Binarios que no aportan nada como texto (fuentes, iconos e imágenes originales)
*.ttf
*.otf
*.webp
recursos/
app/src/main/res/drawable/corazoness.png
